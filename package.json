{
  "name": "golf-course-workbench",
  "productName": "Golf Course Workbench",
  "version": "1.0.0",
  "description": "Editable golf maps, virtual images and GPS workbench",
  "author": "liuguanyi-linux",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "prepare:app": "node scripts/build-app.cjs",
    "test": "node scripts/check.cjs && node tests/app-test.cjs && node tests/service-worker-test.cjs && node tests/app-client-test.cjs",
    "pack:mac": "npm run prepare:app && electron-builder --mac dmg --arm64 --x64 --publish never",
    "pack:win": "npm run prepare:app && electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {"electron": "44.7.0", "electron-builder": "26.15.3"},
  "overrides": {"global-agent": "4.1.3"},
  "build": {
    "appId": "io.github.liuguanyi-linux.golfworkbench",
    "directories": {"output": "dist"},
    "artifactName": "Golf-Workbench-${version}-${os}-${arch}.${ext}",
    "files": ["desktop/**", "app/**", "cn/**", "course-workspace/**", "holemap-*/**", "kingswan/**", "data/**", "docs/**", "downloads/**", "scripts/*.cjs", "index.html", "manifest.webmanifest", "sw.js", "LICENSE", "NOTICE.md", "package.json"],
    "mac": {"category": "public.app-category.productivity", "identity": null, "hardenedRuntime": false, "icon": "app/icon-512.png"},
    "win": {"icon": "app/icon-512.png", "signAndEditExecutable": false},
    "nsis": {"oneClick": false, "allowToChangeInstallationDirectory": true, "deleteAppDataOnUninstall": false},
    "publish": null
  }
}
